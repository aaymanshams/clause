# Copy to .env and fill in. .env is git-ignored and read automatically by the app and docker compose.

# Required for real LLM features. Without it ClauseIQ runs with the offline fallback provider.
OPENAI_API_KEY=your_api_key_here

# auto (default) | openai | offline
AI_PROVIDER=auto
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Leave empty for local development (a random key is generated per run; logins reset on restart).
# Set a long random value for any shared environment: `openssl rand -base64 48`
JWT_SECRET=

# Only needed when not using docker compose
DB_URL=jdbc:postgresql://localhost:5432/clauseiq
DB_USERNAME=clauseiq
DB_PASSWORD=clauseiq
